# Settings for the bSDD Toolkit web app (Docker Compose).
# Copy to .env next to compose.yaml and adjust:  cp .env.example .env
# Empty values use the default. Changes take effect after:  docker compose up -d

# ---------------------------------------------------------------- Docker
# Image tag: latest, a minor version (e.g. 0.2) or an exact version (e.g. 0.2.2)
BSDD_TOOLKIT_TAG=latest
# Port on the host the app is reachable on (http://localhost:<HOST_PORT>)
HOST_PORT=8000

# ---------------------------------------------------------------- Dictionaries
# Delete dictionaries that nobody opened for this many days (0 = keep forever)
PROJECT_TTL_DAYS=0
# Maximum size of uploaded JSON files in MB
MAX_UPLOAD_MB=50
# Rolling backups of every dictionary: one every N seconds while it is edited, keep the last M
SNAPSHOT_INTERVAL=600
MAX_SNAPSHOTS=20
# Key for signing the access tokens of password-protected dictionaries.
# Empty = a random key is created once in the data volume (recommended).
SECRET_KEY=

# ---------------------------------------------------------------- buildingSMART
# 1 = no lookups of external classes/properties on the bSDD API
OFFLINE=0
# Public address of this installation, e.g. https://bsdd.example.org
PUBLIC_URL=
# Optional "Sign in with buildingSMART" for downloading complete dictionaries in one step.
# Request a client ID (single-page application) from bsdd_support@buildingsmart.org with the
# return URL <PUBLIC_URL>/auth/bsdd/callback. Empty = sign-in is switched off.
BSDD_CLIENT_ID=

# ---------------------------------------------------------------- Imprint and privacy policy
# Shown on /imprint and /privacy. Public installations in Germany need both.
# \n starts a new line. Values with spaces need no quotes.
OPERATOR_NAME=
# e.g. Musterweg 1\n12345 Musterstadt
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
# Additional text for the imprint, e.g. VAT ID or the person responsible for the content
IMPRINT_EXTRA=
# Additional text for the privacy policy, e.g. hosting provider, a CDN or proxy in front
# (Cloudflare etc.) and how long the server logs are kept
PRIVACY_EXTRA=
